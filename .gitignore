/target/
/target-*/

# Agent and topic-branch worktrees live inside the checkout.
/.worktrees/

# Local CI/release artifacts
/.ci-*.txt
/dist/
/package/
/logs/
/SHA256SUMS

# Rust profiling/coverage
/coverage/
*.profraw
*.profdata
/perf.data*
/*.trace/

# Local environment/secrets
.env
.env.*
!.env.example

# macOS
.DS_Store
**/.DS_Store
._*

# Cargo-fuzz build state, corpora and crash artifacts.
**/fuzz/target/
**/fuzz/artifacts/
**/fuzz/corpus/
**/fuzz/coverage/

# The fixture corpus, hydrated by `cargo xtask test-corpus hydrate`. Never
# committed: it is published content-addressed; see docs/test-corpus.md.
/tests/media/

# The xtask crate builds into its own directory.
/xtask/target/
